# Text files — normalize line endings
*.py text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sh text eol=lf
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf

# Binary files — no diff, no line ending conversion
*.gif binary
*.png binary
*.jpg binary
*.jpeg binary
*.svg binary
*.onnx binary
