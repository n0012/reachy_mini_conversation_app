# Reachy Mini Conversation App — Environment Variables
# Copy to .env and fill in the secrets marked with <YOUR_...>
# This file is safe to commit. .env is gitignored.

# ── Gemini Live API ───────────────────────────────────────────────────────────
# Required. Get from: https://aistudio.google.com/apikey
# Note: gemini-3.1-flash-live-preview is only available via AI Studio (not Vertex)
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>

# ── Vertex AI (Agent Engine Memory Bank) ─────────────────────────────────────
GCP_PROJECT_ID=losiern-vibe
GCP_LOCATION=us-central1
VERTEX_REASONING_ENGINE_ID=YOUR_ENGINE_ID

# Path to service account key JSON on the robot
GOOGLE_APPLICATION_CREDENTIALS=/home/pollen/.config/gcloud/reachy-mini-sa-key.json

# ── App config ────────────────────────────────────────────────────────────────
MODEL_NAME=gemini-3.1-flash-live-preview
REACHY_MINI_CUSTOM_PROFILE=yuki

# ── MCP server secrets (injected via ${VAR_NAME} in mcp_servers.json) ────────
# Home Assistant long-lived access token
# Create at: http://homeassistant.local:8123/profile/security
HA_MCP_TOKEN=<YOUR_HA_MCP_TOKEN>
